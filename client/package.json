{
  "name": "orlik-vision-client",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:preflight": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.9"
  }
}
